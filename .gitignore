# Binários, modelos e runtime portátil — pesados, baixados/instalados, não são código
/models/
/engine/
/runtime/
/cache/

# Estado/execução local — gerado ao rodar, específico da máquina/usuário
/logs/
/state/
/sessions/
/workspace/
/profiles/machines/*.json

# Snapshots pré-versão — a partir de agora o histórico vive no git, não em backup/
/backup/

# Python
__pycache__/
*.pyc

# Node (build da Forja, se rodado localmente)
forja-de-prompts/node_modules/

# Linux: venv criado por linux/setup/03_python.sh na raiz do projeto
/.venv/
# Linux: binários do llama.cpp (llama-server, .so) — só os LEIA-ME vão pro git
/linux/engine/**
!/linux/engine/*/
!/linux/engine/*/LEIA-ME.txt

# Rede de segurança: pesos de modelo e binários fora das pastas acima
*.gguf
*.safetensors
*.exe
*.dll
*.so
*.so.*

# Segredos locais
.env
.env.*

# Node em qualquer lugar
node_modules/

# Lixo de sistema (Windows / macOS / SSD trocando de máquina)
Thumbs.db
desktop.ini
.DS_Store

# Planilha de TERCEIROS (ControleFinanceiro): a copia do usuario fica so' em
# workspace/financeiro/modelo/ — nunca no repositorio
/config/templates/financeiro/
